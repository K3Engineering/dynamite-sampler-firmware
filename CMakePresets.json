{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "binaryDir": "build/debug",
      "cacheVariables": {
        "IDF_TARGET": "esp32s3",
        "SDKCONFIG_DEFAULTS": "sdkconfig.common;sdkconfig.debug",
        "SDKCONFIG": "build/sdkconfig.debug"
      },
      "vendor": {
        "espressif/vscode-esp-idf": {
          "schemaVersion": 1,
          "settings": [
            {
              "type": "compileArgs",
              "value": [
                "-DIDF_TARGET=esp32s3"
              ]
            },
            {
              "type": "openOCD",
              "value": {
                "debugLevel": 2
              }
            }
          ]
        }
      }
    },
    {
      "name": "release",
      "binaryDir": "build/release",
      "cacheVariables": {
        "IDF_TARGET": "esp32s3",
        "SDKCONFIG_DEFAULTS": "sdkconfig.common;sdkconfig.release",
        "SDKCONFIG": "build/sdkconfig.release"
      },
      "vendor": {
        "espressif/vscode-esp-idf": {
          "schemaVersion": 1,
          "settings": [
            {
              "type": "compileArgs",
              "value": [
                "-DIDF_TARGET=esp32s3"
              ]
            },
            {
              "type": "openOCD",
              "value": {
                "debugLevel": 2
              }
            }
          ]
        }
      }
    }
  ]
}
